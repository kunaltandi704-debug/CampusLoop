# Copy to .env and replace the placeholders. Never commit .env.
FLASK_SECRET_KEY=replace-with-a-random-secret
GOOGLE_API_KEY=replace-with-your-Google-GenAI-key
# Keep demo accounts disabled outside a local demo.
CAMPUSLOOP_DEMO_MODE=0
# For a non-demo install, set both values to bootstrap the first admin (password must be 12+ characters).
# CAMPUSLOOP_ADMIN_EMAIL=admin@example.edu
# CAMPUSLOOP_ADMIN_PASSWORD=replace-with-a-unique-strong-password
# Set to 1 only when serving the app behind HTTPS.
COOKIE_SECURE=0
# Monday 00:00 to next Monday 00:00 defines the weekly attendance reward period.
COLLEGE_TIMEZONE=Asia/Kolkata
# Optional; defaults to ./campusloop.db
# CAMPUSLOOP_DATABASE=C:\path\to\campusloop.db
